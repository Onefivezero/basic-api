package basic_api

import (
	"bytes"
	"encoding/json"
	"fmt"
	"reflect"
)

func ParseNormal(val any, type_ reflect.Type) reflect.Value {
	return reflect.ValueOf(val)
}

func ParseStruct(val any, type_ reflect.Type) reflect.Value {
	dataMap := val.(map[string]any)
	fields := reflect.VisibleFields(type_)
	result := reflect.New(type_)
	for _, fieldInfo := range fields {
		dataVal, exists := dataMap[fieldInfo.Name]
		if !exists { // do something?
			continue
		}
		result.FieldByName(fieldInfo.Name).Set(reflect.ValueOf(dataVal))
	}
	return result
}

func ParseList(val any, innerType reflect.Type) reflect.Value {
	listOfVals := val.([]any)
	resList := make([]reflect.Value, len(listOfVals))
	for _, elem := range listOfVals {
		resList = append(resList, Parse(elem, innerType))
	}
	return reflect.ValueOf(resList)
}

func Parse(val any, type_ reflect.Type) reflect.Value {
	reflectVal := reflect.ValueOf(val)
	reflectType := reflect.TypeOf(val)
	reflectKind := reflectType.Kind()

	switch reflectKind {
	case reflect.Array:
		return ParseList(val, type_.Elem())
	case reflect.Struct:
		return
	}
}

func Verify[T any](mapData map[string]any) T {
	res := Parse(mapData, reflect.TypeFor[T]())
	return res.Interface().(T)
}

func VerifyList[T any](mapData []map[string]any) []T {
	result := make([]T, 0)
	for _, i := range mapData {
		result = append(result, Verify[T](i))
	}
	return result
}

func VerifyBytes[T any](dataref *[]byte) {
	data := *dataref
	var result any
	decoder := json.NewDecoder(bytes.NewReader(data))

	if data[0] == '[' {
		jsonArr := []map[string]any{}
		err := decoder.Decode(jsonArr)
		if err != nil {
			fmt.Println("ERRROR PARSING: %v", err)
			return
		}
		result = VerifyList[T](jsonArr)
	} else if data[0] == '{' {
		jsonData := map[string]any{}
		err := decoder.Decode(jsonData)
		if err != nil {
			fmt.Println("ERRROR PARSING: %v", err)
			return
		}
		result = Verify[T](jsonData)
	}

	fmt.Println(result)
}
